import pandas as pd
from sklearn.model_selection import train_test_split
from sklearn.linear_model import LinearRegression
from sklearn.preprocessing import PolynomialFeatures
from sklearn.metrics import r2_score

data=pd.read_csv("Housing.csv")

x=data[["area"]]
y=data["price"]

xtrain,xtest,ytrain,ytest=train_test_split(x,y,test_size=0.2,random_state=42)

lr=LinearRegression()
lr.fit(xtrain,ytrain)
lpred=lr.predict(xtest)

poly=PolynomialFeatures(degree=2)
xtrain_poly=poly.fit_transform(xtrain)
xtest_poly=poly.transform(xtest)

pr=LinearRegression()
pr.fit(xtrain_poly,ytrain)
ppred=pr.predict(xtest_poly)

print("Linear Regression R2 Score:",r2_score(ytest,lpred))
print("Polynomial Regression R2 Score:",r2_score(ytest,ppred))

sample=[[5000]]
print("Linear Prediction:",lr.predict(sample)[0])
print("Polynomial Prediction:",pr.predict(poly.transform(sample))[0])
