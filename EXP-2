import pandas as pd
import numpy as np

data=pd.read_csv("enjoysport.csv")
concepts=np.array(data.iloc[:,:-1])
target=np.array(data.iloc[:,-1])

S=['0']*len(concepts[0])
G=[['?']*len(concepts[0])]

for i,h in enumerate(concepts):
    if target[i]=="Yes":
        for j in range(len(S)):
            if S[j]=='0':
                S[j]=h[j]
            elif S[j]!=h[j]:
                S[j]='?'
        G=[g for g in G if all(g[k]=='?' or g[k]==S[k] for k in range(len(S)))]
    else:
        Gnew=[]
        for g in G:
            for j in range(len(S)):
                if S[j]!='?' and S[j]!=h[j]:
                    ng=g.copy()
                    ng[j]=S[j]
                    Gnew.append(ng)
        G=Gnew

print("Specific Hypothesis")
print(S)

print("General Hypothesis")
for g in G:
    print(g)
