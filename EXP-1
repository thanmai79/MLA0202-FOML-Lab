import pandas as pd

data=pd.read_csv("enjoysport.csv")

concepts=data.iloc[:,:-1].values
target=data.iloc[:,-1].values

h=concepts[0].copy()

for i in range(len(target)):
    if target[i]=="Yes":
        for j in range(len(h)):
            if h[j]!=concepts[i][j]:
                h[j]="?"

print("Most Specific Hypothesis:")
print(h)
